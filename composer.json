{
    "name": "dcodegroup/laravel-attachments",
    "description": "Allow adding attachments to any document",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "attachments",
        "dcode"
    ],
    "authors": [
        {
            "name": "Nathan Rzepecki",
            "email": "nathan@lionslair.net.au",
            "homepage": "https://nathanrzepecki.me"
        },
        {
            "name": "Dcode Group",
            "email": "forge@dcodegroup.com",
            "homepage": "https://dcodegroup.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "ext-imagick": "*",
        "dcodegroup/laravel-cloudfront-url-signer": "^3.6",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0",
        "mvanduijker/laravel-model-exists-rule": "^3.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/pdf-to-image": "^2.2||^3.1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.45",
        "larastan/larastan": "^2.9|^3.1",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan-deprecation-rules": "^1.1|^2.0.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dcodegroup\\LaravelAttachments\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcodegroup\\LaravelAttachments\\LaravelAttachmentsServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    }
}
